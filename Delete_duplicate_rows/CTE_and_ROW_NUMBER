--Using CTE(Common Table Expression) and ROW_NUMBER
--IF we dont want a data where MakeName is double 
WITH CTE AS (
SELECT MakeName,ModelName,ROW_NUMBER() OVER (PARTITION BY MakeName ORDER BY(SELECT NULL)) AS duplicate_row
FROM car_model
)

DELETE FROM CTE WHERE duplicate_row>1 ;
